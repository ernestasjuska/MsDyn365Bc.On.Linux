SA_PASSWORD=Passw0rd123!
BC_CLEAR_ALL_APPS=false

# Self-hosted web client PoC.
BC_WEBCLIENT=1

# Entra ID sign-in for the web client. The tier stays on NavUserPassword; only the
# web client is AccessControlService.
BC_AAD_APP_ID=23a0b535-a9a2-44a6-bf95-b809eadd9cb9
BC_AAD_TENANT_ID=77ee4728-d50c-4cf7-ae48-8429406536c6
# Must be the token's email claim, not the directory UPN: this account signs in
# through live.com, so the directory UPN never appears in the token.
BC_AAD_USER_UPN=ernestasju@gmail.com

# Public address the browser uses. BC derives both PublicWebBaseUrl and the
# WebSocket allowed-origin list from this, so the port has to be included.
BC_WEBCLIENT_PUBLIC_URL=https://skk4hpvt.euw.devtunnels.ms:8080/
BC_WEBCLIENT_PUBLIC_HOST=skk4hpvt.euw.devtunnels.ms:8080

# Traefik terminates the browser connection and re-originates TLS to bc, so the
# web client sees https natively rather than inferring it from a forwarded header.
BC_WEBCLIENT_HOST_PORT=8081
BC_WEBCLIENT_HTTPS_PFX=/certs/bc.pfx
BC_WEBCLIENT_HTTPS_PFX_PASSWORD=bcdev
BC_WEBCLIENT_FORWARDED_HEADERS=0
